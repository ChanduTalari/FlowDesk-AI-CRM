# Backend environment
NODE_ENV=development
PORT=3001

# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Supabase Auth redirects must also be configured in the Supabase dashboard.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# SMTP / SendGrid
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASS=YOUR_SMTP_API_KEY
# For SendGrid, this address must be a verified sender identity.
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=AI CRM
EMAIL_QUEUE_CONCURRENCY=2
EMAIL_QUEUE_RETRIES=3

# SendGrid Inbound Parse private webhook URL token
SENDGRID_INBOUND_TOKEN=generate-a-long-random-inbound-webhook-token
INBOUND_EMAIL_MAX_BODY_LENGTH=100000

# Durable AI and follow-up worker
WORKER_POLL_INTERVAL_MS=15000
WORKER_LEASE_SECONDS=120
WORKER_CONCURRENCY=2

# Public intake webhook
WEBHOOK_SECRET=generate-a-long-random-secret
WEBHOOK_MAX_AGE_MS=300000

# AI provider (OpenAI-compatible)
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_STANDARD=120
RATE_LIMIT_WEBHOOK=60
RATE_LIMIT_AI=20
